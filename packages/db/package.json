{
  "name": "@perpetually/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest --reporter=verbose",
    "test:ci": "vitest run --reporter=verbose",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push:pg",
    "db:drop": "tsx ./scripts/drop-db.ts",
    "db:seed": "NODE_ENV=development tsx seed.ts",
    "db:reset": "npm run db:drop && npm run db:push && npm run db:seed",
    "customers:generate": "tsx ./scripts/generate-customers.ts"
  },
  "exports": {
    ".": "./db/config.server.ts",
    "./schema": "./db/schema.server.ts",
    "./config": "./db/config.server.ts",
    "./models": "./models/index.ts",
    "./types": "./types.ts",
    "./utils": "./lib/utils.ts",
    "./logger": "./lib/logger.ts",
    "./factory": "./factory.ts"
  },
  "main": "./db/config.server.ts",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bs58": "^5.0.0",
    "clsx": "^2.1.1",
    "consola": "^3.2.3",
    "date-fns": "^3.3.1",
    "drizzle-orm": "^0.29.3",
    "nanoid": "^5.0.7",
    "postgres": "^3.4.4",
    "slug": "^8.2.3",
    "stripe": "^19.3.0",
    "tailwind-merge": "^2.2.1",
    "tiny-invariant": "^1.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.1.0",
    "@types/slug": "^5.0.7",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.20.14",
    "tsx": "^4.7.0",
    "typescript": "^5.1.6",
    "vitest": "^1.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
