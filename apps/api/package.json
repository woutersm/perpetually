{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "typecheck": "tsc --noEmit",
    "tsoa:spec": "npx tsoa spec",
    "tsoa:routes": "npx tsoa routes",
    "test": "vitest --reporter=verbose",
    "test:ci": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "@perpetually/db": "workspace:*",
    "@tsoa/runtime": "^6.6.0",
    "class-validator": "^0.14.2",
    "compression": "^1.7.4",
    "consola": "^3.2.3",
    "drizzle-orm": "^0.29.3",
    "express": "^4.18.2",
    "express-openapi-validator": "^5.2.0",
    "morgan": "^1.10.0",
    "tiny-invariant": "^1.3.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.20",
    "@types/js-yaml": "^4.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.1.0",
    "@types/slug": "^5.0.7",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "cross-env": "^7.0.3",
    "eslint": "^8.38.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "js-yaml": "^4.1.0",
    "prettier": "^3.2.4",
    "supertest": "^7.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.6.0",
    "tsx": "^4.7.0",
    "typescript": "^5.1.6",
    "vitest": "^1.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
