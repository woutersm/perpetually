{
	"name": "perpetually-dash",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"serve": "bun --bun vite preview",
		"start": "bun run .output/server/index.mjs",
		"test": "bun --bun test",
		"typecheck": "bunx tsc --noEmit",
		"db:generate": "bunx drizzle-kit generate",
		"db:migrate": "bunx drizzle-kit migrate",
		"db:push": "bunx drizzle-kit push --force",
		"db:seed": "bun --env-file=.env ./scripts/seed.ts",
		"db:setup": "bun run db:generate && bun run db:migrate && bun run db:seed",
		"trigger:dev": "bunx trigger dev",
		"trigger:deploy": "bunx trigger deploy"
	},
