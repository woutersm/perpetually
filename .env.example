# ---- Core ----
# Local SQLite file, or a libSQL/Turso URL (libsql://<db>.turso.io)
DATABASE_URL=sqlite.db
# DATABASE_AUTH_TOKEN=            # required for Turso

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3001
APP_URL=http://localhost:3001
VITE_APP_URL=http://localhost:3001
PORT=3000                         # production server (bun run start)

# ---- Public demo ----
# DEMO_MODE=true                  # per-visitor sandboxes, disables sign-up
# SANDBOX_TTL_HOURS=24
# SANDBOX_MAX_ACTIVE=500

# ---- Seed ----
# TEST_USER_PASSWORD=testpassword123

# ---- Email (optional; emails are skipped when unset) ----
# RESEND_API_KEY=re_xxx

# ---- Stripe: Perpetually's own subscription billing (optional) ----
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_PRICE_PRO=price_xxx
# STRIPE_PRICE_BUSINESS=price_xxx
# STRIPE_BILLING_WEBHOOK_SECRET=whsec_xxx

# ---- Logging ----
# LOG_LEVEL=debug                 # debug|info|warn|error
# LOG_FORMAT=pretty               # json|pretty
